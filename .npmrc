# `@solana-program/token-2022@0.12` declares a peer of `@solana/sysvars@^5`,
# while `@solana/kit@6` — which this project depends on directly — brings
# `@solana/sysvars@6`. npm's strict peer resolution refuses the pair outright.
#
# The versions themselves are not in question: package-lock.json already pins a
# working tree, with the two copies nested where they need to be, and that is
# the tree this app has been built and tested against. This setting is what
# lets a clean `npm install` reproduce it instead of failing to resolve.
#
# Without it, a fresh install works locally only because node_modules is
# already populated — which is exactly the difference between a laptop and a
# build container, and why the first Railway build failed.
legacy-peer-deps=true
