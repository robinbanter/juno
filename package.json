{
  "name": "juno",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "build": "SERWIST_SUPPRESS_TURBOPACK_WARNING=1 next build --webpack",
    "build:turbo": "SERWIST_SUPPRESS_TURBOPACK_WARNING=1 next build",
    "start": "next start",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "juno:launch": "dotenv -e .env.local -- tsx scripts/juno-launch.ts",
    "juno:inspect": "dotenv -e .env.local -- tsx scripts/juno-inspect.ts",
    "juno:trade": "dotenv -e .env.local -- tsx scripts/juno-trade.ts",
    "juno:claim": "dotenv -e .env.local -- tsx scripts/juno-claim.ts",
    "juno:graduate": "dotenv -e .env.local -- tsx scripts/juno-graduate.ts",
    "juno:swaps": "dotenv -e .env.local -- tsx scripts/juno-swaps.ts",
    "juno:fork": "tsx scripts/juno-fork.ts",
    "juno:pyth": "dotenv -e .env.local -- tsx scripts/juno-pyth.ts"
  },
  "dependencies": {
    "@meteora-ag/dynamic-bonding-curve-sdk": "^1.5.12",
    "@radix-ui/react-accordion": "^1.2.14",
    "@serwist/next": "^9.5.11",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@solana/wallet-adapter-wallets": "^0.19.39",
    "@solana/web3.js": "^1.99.0",
    "@tanstack/react-query": "^5.101.0",
    "bn.js": "^5.2.5",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.21.0",
    "mongodb": "^7.6.0",
    "next": "16.2.9",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.1"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.0",
    "@img/sharp-linux-x64": "0.35.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "serwist": "^9.5.11",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
