# ─────────────────────────────────────────────────────────────────────────────
# Norr — environment configuration
# Copy to .env.local and fill in. Everything here is server-side unless prefixed
# with NEXT_PUBLIC_ (which is embedded in the browser bundle).
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth: Privy (wallet login + embedded Algorand wallet) ──
# Create a free app at https://dashboard.privy.io, enable "Solana" + embedded
# Solana wallets, and enable the login methods you want (email/google/etc).
NEXT_PUBLIC_PRIVY_APP_ID=your-25-char-privy-app-id
# Server-only Privy secret (future server-side Privy calls). Never NEXT_PUBLIC_.
PRIVY_APP_SECRET=

# Signs the Norr session cookie (any long random string). A dev default is used
# if unset; ALWAYS set a real value in production.
SESSION_SECRET=change-me-to-a-long-random-string

# ── Database: PostgreSQL (Neon / Supabase / any Postgres) ──
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Optional unpooled/direct URL for DDL (drizzle-kit push/migrate).
# DATABASE_URL_UNPOOLED=

# ── Algorand ──
# The one switch that decides real vs play money. "mainnet" means every payment
# is real USDC (asset 31566704); "testnet" uses test USDC (10458941) and is the
# default — MainNet must be opted into explicitly.
NEXT_PUBLIC_ALGO_NETWORK=testnet

# Platform wallet. It pays gas and seeds each new user wallet with ~0.3 ALGO so
# the wallet can opt in to USDC and pay fees. It is NOT a treasury: it never
# funds anyone's balance, and users deposit their own USDC.
# Fund it with ALGO, then run `npm run wallet:setup` to opt it in to USDC.
DEPLOYER_MNEMONIC="25 word mnemonic ..."
DEPLOYER_ADDRESS=

# Node access. Leave ALGOD_SERVER unset so NEXT_PUBLIC_ALGO_NETWORK picks the
# right AlgoNode endpoint; set it only to use your own node.
# ALGOD_SERVER=
ALGOD_PORT=443
ALGOD_TOKEN=
# INDEXER_SERVER=

# The payment asset is real USDC, resolved from the network above. Only set this
# to point at a different asset on a local sandbox/fork.
# USDC_ASSET_ID_OVERRIDE=

# Encrypts custodial wallet secret keys at rest (base64-encoded 32-byte key).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# This IS the money: lose it and every user's wallet is permanently unopenable.
CUSTODIAL_KEY_ENCRYPTION_SECRET=
# Rotation: add the new key as _V2 (KEEPING the old one readable), set
# CUSTODIAL_KEY_VERSION=2, run `npm run keys:rotate`, then retire the old secret
# once every wallet reports v2. Old versions must stay readable until then.
# CUSTODIAL_KEY_ENCRYPTION_SECRET_V2=
# CUSTODIAL_KEY_VERSION=1

# ── Media storage: Supabase Storage (private bucket) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=media
# Alternative backend: Vercel Blob (used if the Supabase vars are unset).
# BLOB_READ_WRITE_TOKEN=

# ── x402 (machine-payable content) ──
# The facilitator that verifies + settles x402 payments on Algorand. It must
# support the AVM: x402.org's public facilitator is EVM-only and cannot settle
# Algorand, so this defaults to an AVM-capable one. Check GET /supported before
# changing it.
# X402_FACILITATOR_URL=https://facilitator.goplausible.xyz

# Only for `npm run x402:buy` (the demo client): a wallet holding USDC to pay
# with. Never needed by the server.
# X402_BUYER_MNEMONIC="25 word mnemonic ..."

# ── Adding funds ──
# There is no card processor and no treasury: users add credit by sending their
# own USDC to their wallet address (see /add-funds). Nothing to configure.
# Card top-ups are a later addition and would need a real processor + a funded
# treasury to sell USDC out of.

# ── Unlock ownership ──
# An unlock is a purchase: leave this ON. With it off, the unlock path deletes
# the fan's prior unlock and charges them AGAIN for content they already bought
# — every view, in real USDC — and their Collection stays permanently empty.
# Only set "false" for a throwaway demo that wants to re-unlock repeatedly.
# PERSIST_UNLOCK_OWNERSHIP=true

# ── Content scanning ──
# Automated safety scanning of uploaded media. "none" (the default) publishes
# every upload UNEXAMINED — fine for local dev, not for a public adult platform:
# CSAM liability is strict and does not care that no scanner was wired yet.
# `mainnet:preflight` blocks on this.
# Set to "hive" + HIVE_API_KEY (https://thehive.ai) to enable. Anything the
# scanner flags — or fails to decide — is quarantined and reported, never served.
CONTENT_SCAN_PROVIDER=none
# HIVE_API_KEY=

# ── §2257 records ──
# 18 U.S.C. §2257 requires a producer of sexually explicit content to keep age
# and consent records for every performer. When "true", a creator cannot publish
# without a VERIFIED record on file. Off by default so local dev and tests don't
# need real ID documents; `mainnet:preflight` blocks on it being off.
# Enforcement is code — naming a custodian of records, the retention process and
# the public notice are legal/operational and are NOT supplied by this repo.
REQUIRE_2257_RECORDS=false

# ── Legal notices (/legal/compliance) ──
# Real values only — the page prints "not configured" rather than inventing them,
# and `mainnet:preflight` blocks while they're unset.
# The DMCA agent must be a real person/entity registered with the US Copyright
# Office (§512(c) safe harbour depends on it). The §2257 custodian is a named
# individual at a physical address.
# DMCA_AGENT_NAME=
# DMCA_AGENT_EMAIL=
# DMCA_AGENT_ADDRESS=
# RECORDS_CUSTODIAN_NAME=
# RECORDS_CUSTODIAN_ADDRESS=

# ── Moderation ──
# Operator bearer token for /api/moderation/* (the report queue + takedowns).
# Fails CLOSED: unset or under 16 chars means nobody can moderate, so set it
# before taking real users. Reporting itself (/api/reports) needs no account.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MODERATION_SECRET=

# ── Alerting ──
# Where a FATAL failure goes — a settlement that never landed, a withdrawal that
# 500s. Slack-shaped POST; any endpoint that accepts JSON works. Unset, these
# still emit one structured JSON line (filter on level=fatal AND category=money
# in whatever collects your logs), but nobody is woken up.
# ALERT_WEBHOOK_URL=

# ── App ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Juno — which cluster to launch and trade against ("devnet" | "mainnet-beta")
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Dedicated RPC. The public endpoints rate-limit hard enough to break a demo.
NEXT_PUBLIC_SOLANA_RPC=

# Juno — Pinata (IPFS) for media uploads and token metadata JSON
PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# Juno — MongoDB for social state (comments, likes, names) and the sealed
# devnet faucet key. Follows, plans, watchlists and swaps are in Postgres.
MONGODB_URI=
MONGODB_DB=juno

# Juno — where Pyth price accounts are read. Defaults to Solana mainnet: the
# push oracle does not publish to devnet, and a devnet curve is marked against
# the real mainnet price on purpose.
# PYTH_RPC_URL=

# Juno — the app's public URL. When set, every non-API page on this server
# redirects to it (the server is Juno's API; its own pages are legacy Norr).
# JUNO_APP_URL=https://juno-app-chi.vercel.app

# Juno — the devnet faucet needs no key here. It generates its own on first
# use, sealed with CUSTODIAL_KEY_ENCRYPTION_SECRET; GET /api/juno/faucet shows
# its address, and sending devnet SOL there funds it.
