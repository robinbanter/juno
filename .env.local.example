# Juno — copy to .env.local and fill in.
#
# Only DATABASE_URL and NEXT_PUBLIC_SOLANA_CLUSTER are needed to boot. The rest
# switch on individual features, and every one of them degrades honestly when
# absent rather than faking a value.

# --- required ---

# Postgres (Neon) for the juno_pools registry. Identity and provenance only —
# every number that moves is read from the DBC program per request.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# devnet | mainnet-beta | mainnet-fork
# mainnet-fork = mainnet addresses (USDC, Pyth) on a local validator, RPC default
# http://127.0.0.1:8899. `npm run juno:fork` prints the accounts to clone.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# --- strongly recommended ---

# A dedicated RPC. The public endpoints enforce a per-method quota that the
# swap indexer can exhaust in a dozen reads, which is what turns the price
# chart, 24h volume and trade direction into em-dashes. See lib/juno/indexer.ts.
NEXT_PUBLIC_SOLANA_RPC=

# Signs wallet sessions (lib/juno/session.ts). At least 32 random characters,
# e.g. `openssl rand -base64 48`. Without it likes, comments and follows are
# refused with 503: they are keyed by wallet, and without a session there is no
# proof the caller holds the wallet they name.
SESSION_SECRET=

# --- optional ---

# Pinata JWT. Pins media and token metadata to IPFS. Without it a mint launches
# with uri: "" and every wallet and explorer renders the coin blank.
PINATA_JWT=

# Gateway baked into pinned metadata, for wallets and explorers that cannot
# reach this app's own /api/ipfs/<cid> route.
NEXT_PUBLIC_IPFS_GATEWAY=

# Comments. Unset, the comments route throws; nothing else is affected.
MONGODB_URI=
MONGODB_DB=juno

# Pyth prices are read straight from Solana (PriceUpdateV2 accounts), no key.
# A Hermes key is only a fallback for feeds the chain cannot answer.
PYTH_API_KEY=
# Seconds before a Pyth price is shown as stale instead of as a number.
# Devnet's sponsored feeds push roughly every 5 minutes. Default 600.
PYTH_MAX_AGE_SECONDS=

# Absolute URL for metadata and OG images. Set this in production or shared
# links fall back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Slack-shaped webhook. Fatal errors are logged either way; this is only how a
# human gets paged about them.
ALERT_WEBHOOK_URL=

# --- database tuning (defaults are fine) ---

# Direct, unpooled connection string. drizzle-kit uses it for migrations,
# falling back to DATABASE_URL. On Neon, migrations through the pooler can
# fail, so set one of these if `npm run db:push` misbehaves.
DATABASE_URL_UNPOOLED=
DATABASE_DIRECT_URL=

# Postgres pool size. Default 5. Serverless wants this small — each instance
# opens its own pool.
DATABASE_POOL_MAX=

# "require" (default behaviour for hosted Postgres) or "disable" for a local
# server without TLS.
DATABASE_SSL=

# --- debugging ---

# Any truthy value makes lib/juno/indexer.ts log why a swap-history read came
# back empty, instead of failing silently. Leave unset in production.
JUNO_DEBUG=
