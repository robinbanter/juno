# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which is the only way a new checkout knows what to set.
# `.env*` above matches it, so this negation is required, not decorative.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.claude
NSFW.png
test.mp4
.design 
# auto-blur: local test artifacts (raw + API-returned NSFW derivatives)
/auto-blur/api-output/
/auto-blur/*.mp4
/auto-blur/*.mov
/auto-blur/*.webm
/auto-blur/*.m4v
/auto-blur/*.mkv
# python bytecode (cog dev)
__pycache__/
*.pyc

# clerk configuration (can include secrets)
/.clerk/

# Scratch files. `git add -A` will happily commit a throwaway script you made to
# fund a wallet — it already did once (f.tmp.mjs, 690efc7). Name temp work
# *.tmp.* and it cannot happen again.
*.tmp.*
.juno/
.juno
